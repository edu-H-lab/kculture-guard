{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node source/scripts/vercel-prepare.js",
  "outputDirectory": "public",
  "installCommand": "npm install --prefix source/server",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "program/assets/js/**/*.js"
    }
  }
}
