# ===================================================
#  AI 포함 실행을 위한 설정 (생각친구 · 교사용 AI 분석)
# ===================================================
#  1) 이 파일을 복사해서 같은 폴더에 " .env " 라는 이름으로 저장하세요.
#     (파일명 앞뒤 공백 없이 정확히 .env 여야 합니다)
#  2) 아래 GEMINI_API_KEY= 뒤에 발급받은 키를 붙여넣으세요.
#     키 발급: https://aistudio.google.com/apikey (구글 계정으로 무료 발급)
#  3) THINKING_FRIEND_PROVIDER 를 gemini 로 바꾸세요.
#  4) program 폴더의 "2_AI포함_실행하기.bat" 을 두 번 누르면
#     http://localhost:8780 에서 AI 기능까지 바로 실행됩니다.
#
#  .env 를 만들지 않으면(또는 키를 넣지 않으면) 생각친구는 정해진
#  질문·정리 문장으로 동작하고, 교사용 AI 분석 버튼만 사용할 수 없습니다.
# ===================================================

PORT=8780

# mock(AI 없이 정해진 문장) | gemini(AI 사용)
THINKING_FRIEND_PROVIDER=mock

# --- Gemini 사용 시 아래 값을 채우세요 ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- (선택) OpenAI 를 쓰는 경우에만 사용 ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
