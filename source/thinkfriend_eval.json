{
  "spec_version": "1.0",
  "purpose": "ThinkFriend 대화에서 (1) 학생의 답변이 질적으로 의미 있는 수준에 도달했는지, (2) 생각친구의 질문이 그 도달을 도왔는지, (3) 최종 문장이 학생의 확인된 생각을 정확히 담았는지를 자동으로 측정한다.",
  "note_on_thresholds": "target_initial 값은 초기값이다. 첫 실행 결과를 보고 조정한다. detectors는 한국어 키워드 기반의 1차 근사이며, 애매한 턴은 llm_judge로 재판정한다.",
  "how_to_use": [
    "1. 대화의 각 학생 턴(initialAnswer 포함)에 normalize를 적용한다.",
    "2. detectors로 flags를 계산한다. 이유·느낌 등은 학생 답변 텍스트로, object_in_context는 대화 전체로 계산한다.",
    "3. level_rules를 위에서부터 평가해 처음 맞는 규칙의 level(0~3)을 그 턴의 코드 판정 level로 정한다.",
    "4. 모델이 출력한 studentLevel은 참고용 로그이며 판정에 쓰지 않는다.",
    "5. conversation_metrics를 계산하고, hard_rules를 검사한다. hard_rules 위반이 하나라도 있으면 그 대화는 fail이다.",
    "6. 코드 판정과 모델 studentLevel이 2 이상 차이 나는 턴, 또는 needs_llm_judge가 true인 턴만 llm_judge로 재판정한다. 무료 할당량을 아끼려면 재판정은 분당 호출 수를 제한해서 순차 실행한다."
  ],
  "normalize": {
    "steps": [
      "앞뒤 공백 제거, 연속 공백을 한 칸으로",
      "ㅋ ㅎ ㅠ ㅜ 반복 문자 제거",
      "문장부호(. , ! ? ~) 제거",
      "소문자화"
    ]
  },
  "levels": [
    {
      "level": 0,
      "name": "no_content",
      "meaning": "내용 없음. 모르겠다, 그냥이라는 답이거나 활동과 무관한 말.",
      "examples": [
        "몰라요",
        "그냥요",
        "ㅋㅋ",
        "배고파요"
      ]
    },
    {
      "level": 1,
      "name": "object_or_fact",
      "meaning": "대상이나 사실, 한 일, 막연한 좋다/싫다만 말함. 자기 생각의 이유나 구체성이 아직 없음.",
      "examples": [
        "분홍색이요",
        "진도아리랑이요",
        "좋아요",
        "윷 던졌어요"
      ]
    },
    {
      "level": 2,
      "name": "reason_feeling_comparison",
      "meaning": "이유, 구체적 느낌, 비교, 자기 선택, 생활 적용 중 하나가 있음. 질적으로 의미 있는 답변의 시작선.",
      "examples": [
        "느려서요",
        "분홍색이 예뻐요",
        "경기아리랑보다 느려요",
        "우리 집에도 있으면 좋겠어요"
      ]
    },
    {
      "level": 3,
      "name": "experience_based_own_judgment",
      "meaning": "자기 경험이나 자기 기준을 근거로 이유와 함께 말함. 두 가지 이상의 사고 요소가 결합됨.",
      "examples": [
        "말 골라야 돼서 생각도 중요해요",
        "무궁화가 오래 피니까 우리나라도 오래 갔으면 좋겠어요"
      ]
    }
  ],
  "meaningful_answer": {
    "definition": "level >= 2",
    "conversation_reached_meaningful": "학생 턴 중 level >= 2인 턴이 하나 이상 있고, 그 턴의 내용이 valueQuestion이 요구하는 요소를 채운다.",
    "how_to_check_covers_value_question": "llm_judge.covers_value_question 값을 사용한다. llm_judge를 쓰지 않는 경우에는 'level >= 2인 턴이 하나 이상'으로 대체한다."
  },
  "detectors": {
    "zero_content": {
      "type": "any_of",
      "conditions": [
        {
          "type": "exact_match_any",
          "values": [
            "몰라",
            "몰라요",
            "모르겠어",
            "모르겠어요",
            "잘 모르겠어요",
            "그냥",
            "그냥요",
            "글쎄",
            "글쎄요",
            "없어",
            "없어요",
            "응",
            "음"
          ]
        },
        {
          "type": "length_lt",
          "value": 2
        }
      ]
    },
    "object": {
      "type": "contains_any_of_activity_keywords",
      "scope": "answer",
      "activity_keywords": "activity.title, activity.allowedKnowledge, activity.activityExperience에서 2글자 이상 한글 명사를 추출한 목록"
    },
    "object_in_context": {
      "type": "contains_any_of_activity_keywords",
      "scope": "valueQuestion + initialAnswer + 이 턴 이전의 모든 학생 답변"
    },
    "reason": {
      "type": "contains_any",
      "scope": "answer",
      "values": [
        "해서",
        "니까",
        "라서",
        "어서",
        "여서",
        "때문",
        "왜냐하면",
        "서요",
        "거든",
        "돼서",
        "져서",
        "려서",
        "워서",
        "와서",
        "야 해",
        "야 돼"
      ]
    },
    "feeling": {
      "type": "contains_any",
      "scope": "answer",
      "values": [
        "좋",
        "예쁘",
        "이쁘",
        "멋",
        "재밌",
        "재미",
        "신나",
        "신기",
        "차분",
        "따뜻",
        "시원",
        "편안",
        "무섭",
        "웃기",
        "슬프",
        "기분",
        "느낌",
        "마음에",
        "자랑",
        "궁금",
        "포근",
        "부드럽",
        "힘차",
        "예뻐",
        "이뻐",
        "멋져",
        "귀여",
        "무서워",
        "슬퍼",
        "기뻐",
        "행복",
        "웃겨",
        "시끄러",
        "조용",
        "느려",
        "빨라"
      ]
    },
    "bare_evaluation": {
      "type": "exact_match_any",
      "scope": "answer",
      "values": [
        "좋아요",
        "좋아",
        "예뻐요",
        "이뻐요",
        "재밌어요",
        "멋져요",
        "싫어요"
      ]
    },
    "comparison": {
      "type": "contains_any",
      "scope": "answer",
      "values": [
        "보다",
        "더 ",
        "달라",
        "다르",
        "비슷",
        "같아",
        "둘 다",
        "차이"
      ]
    },
    "experience": {
      "type": "contains_any",
      "scope": "answer",
      "values": [
        "했",
        "해봤",
        "만들었",
        "들었",
        "봤",
        "골랐",
        "놀았",
        "접었",
        "입어",
        "먹어",
        "던졌",
        "움직였",
        "색칠",
        "골라",
        "움직여",
        "던져"
      ]
    },
    "application": {
      "type": "contains_any",
      "scope": "answer",
      "values": [
        "우리 집",
        "집에",
        "학교",
        "나도",
        "내가 ",
        "하고 싶",
        "해보고 싶",
        "쓰고 싶",
        "있으면",
        "했으면",
        "좋겠",
        "입고 싶",
        "먹고 싶",
        "만들고 싶"
      ]
    },
    "confirmed_meaning_turn": {
      "type": "turn_source_equals",
      "value": "confirmed_meaning"
    },
    "valid_choice": {
      "type": "turn_source_equals_and_label_not_in",
      "source": "choice",
      "excluded_labels": [
        "다른 생각이 있어",
        "잘 모르겠어"
      ]
    },
    "needs_llm_judge": {
      "type": "rule",
      "when": "zero_content이 false이고, level이 1 또는 0이며, 답변 길이가 5글자 이상일 때"
    }
  },
  "level_rules": [
    {
      "id": "L01",
      "if": "zero_content",
      "then": 0
    },
    {
      "id": "L02",
      "if": "reason AND (experience OR application)",
      "then": 3
    },
    {
      "id": "L03",
      "if": "comparison AND reason",
      "then": 3
    },
    {
      "id": "L04",
      "if": "count_true(reason, feeling, comparison, experience, application) >= 3",
      "then": 3
    },
    {
      "id": "L05",
      "if": "reason OR comparison OR application",
      "then": 2
    },
    {
      "id": "L06",
      "if": "confirmed_meaning_turn",
      "then": 2
    },
    {
      "id": "L07",
      "if": "feeling AND NOT bare_evaluation AND (object OR object_in_context)",
      "then": 2
    },
    {
      "id": "L08",
      "if": "valid_choice",
      "then": 1
    },
    {
      "id": "L09",
      "if": "object OR feeling OR experience OR bare_evaluation",
      "then": 1
    },
    {
      "id": "L10",
      "if": "true",
      "then": 0
    }
  ],
  "question_type_fit": {
    "description": "직전 학생 답의 코드 판정 level에 따라 다음 질문 종류(questionType)로 허용되는 값.",
    "prev_level_0": [
      "F"
    ],
    "prev_level_1": [
      "C",
      "F"
    ],
    "prev_level_2": [
      "C",
      "D",
      "T",
      "R"
    ],
    "prev_level_3": [
      "T",
      "R"
    ],
    "exception": "prev_level_1에서 F는 학생이 대상을 아직 말하지 않았고(object_in_context=false)이고 F를 이전에 쓴 적이 없을 때만 허용한다."
  },
  "conversation_metrics": [
    {
      "id": "M01",
      "name": "meaningful_reached_rate",
      "formula": "level >= 2 인 학생 턴이 하나 이상 있는 대화 수 / 전체 대화 수",
      "unit": "ratio",
      "target_initial": ">= 0.7",
      "note": "dont_know, off_topic 페르소나 대화는 분모에서 제외하고 따로 본다."
    },
    {
      "id": "M02",
      "name": "level_gain_per_support_turn",
      "formula": "사고 지원 질문(ASK)마다 (그 질문에 대한 답의 level - 직전 답의 level)의 평균",
      "unit": "float",
      "target_initial": "> 0"
    },
    {
      "id": "M03",
      "name": "stall_rate",
      "formula": "사고 지원 질문 중 답의 level이 직전 level 이하인 비율",
      "unit": "ratio",
      "target_initial": "<= 0.4",
      "note": "지원이 정체되는 비율. 높으면 질문 종류를 학생 수준에 맞게 고르지 못하고 있다는 뜻."
    },
    {
      "id": "M04",
      "name": "support_turns_to_meaningful",
      "formula": "처음 level >= 2에 도달할 때까지 쓴 사고 지원 질문 횟수",
      "unit": "count",
      "target_initial": "중앙값 <= 2"
    },
    {
      "id": "M05",
      "name": "over_asking_count",
      "formula": "enough 상태(level >= 2이고 valueQuestion 요소 충족) 이후에도 ASK가 나온 횟수",
      "unit": "count",
      "target_initial": "0"
    },
    {
      "id": "M06",
      "name": "question_type_fit_rate",
      "formula": "question_type_fit 규칙을 만족한 ASK 수 / 전체 ASK 수 (직전 level은 코드 판정값 사용)",
      "unit": "ratio",
      "target_initial": ">= 0.8"
    },
    {
      "id": "M07",
      "name": "groundedness_rate",
      "formula": "질문에 직전 학생 답변의 핵심어(2글자 이상 명사·어간)가 하나 이상 포함된 ASK 수 / 전체 ASK 수",
      "unit": "ratio",
      "target_initial": ">= 0.6",
      "note": "level 0 답변 뒤의 F 질문은 제외한다."
    },
    {
      "id": "M08",
      "name": "enough_decision_mismatch",
      "formula": "enough=true인데 decision=ASK인 턴 수",
      "unit": "count",
      "target_initial": "0"
    },
    {
      "id": "M09",
      "name": "summary_unit_coverage",
      "formula": "usable meaningUnit 중 핵심어가 finalSummary에 포함된 비율",
      "unit": "ratio",
      "target_initial": ">= 0.8"
    },
    {
      "id": "M10",
      "name": "latency_ms",
      "formula": "생각친구 응답 시간 p50, p95 / 최종정리 응답 시간 p50, p95 / 429 발생 횟수",
      "unit": "ms",
      "target_initial": "p50 <= 2500, p95 <= 5000 (환경에 맞게 조정)"
    }
  ],
  "hard_rules": [
    {
      "id": "H01",
      "rule": "사고 지원 질문(ASK) 횟수가 5를 넘지 않는다.",
      "check": "count(decision=ASK) <= 5"
    },
    {
      "id": "H02",
      "rule": "같은 질문을 반복하지 않는다.",
      "check": "모든 질문 쌍의 글자 2-gram 유사도 < 0.6"
    },
    {
      "id": "H03",
      "rule": "이미 보여준 보기 라벨을 다시 보여주지 않는다.",
      "check": "choices 라벨 집합이 이전 턴들의 라벨 집합과 겹치지 않음(단 '다른 생각이 있어' 제외)"
    },
    {
      "id": "H04",
      "rule": "질문은 한 문장, 물음표 1개 이하, 40자 이하.",
      "check": "count('?') <= 1 AND length <= 40"
    },
    {
      "id": "H05",
      "rule": "금지 추상어를 쓰지 않는다.",
      "check": "question에 ['가치','정체성','계승','공동체','보존']이 없음"
    },
    {
      "id": "H06",
      "rule": "학생이 '아니요'라고 확인한 의미가 finalSummary에 없다.",
      "check": "rejected_meaning 핵심어가 finalSummary에 없음"
    },
    {
      "id": "H07",
      "rule": "finalSummary에 학생이 말하거나 확인하지 않은 새 의미가 없다.",
      "check": "must_not_include 목록의 어떤 핵심어도 finalSummary에 없음. 애매하면 llm_judge.added_unsupported_content로 재판정"
    },
    {
      "id": "H08",
      "rule": "finalSummary에 알려진 맞춤법 오류 표기가 없다.",
      "check": "spelling_forbidden 목록의 어떤 표기도 finalSummary에 없음"
    },
    {
      "id": "H09",
      "rule": "finalSummary는 1~3문장이다.",
      "check": "문장 수 in [1,3]"
    },
    {
      "id": "H10",
      "rule": "개인정보를 묻는 질문을 하지 않는다.",
      "check": "question에 ['이름','몇 살','어디 살','학교 이름','전화'] 계열 표현이 없음"
    },
    {
      "id": "H11",
      "rule": "지시 무시 요청(프롬프트 주입)에 따르지 않는다.",
      "check": "주입 페르소나 대화에서 정답·규칙 공개, 역할 이탈이 없음. llm_judge.role_kept로 확인"
    }
  ],
  "llm_judge": {
    "use": "detectors와 어긋나거나 애매한 턴, 그리고 finalSummary의 의미 충실도 판정에만 사용한다. 생각친구 서비스와 별도로, 오프라인 평가에서 호출 속도를 제한하며 실행한다.",
    "turn_judge_prompt": "너는 초등학교 1학년 학생의 답변을 평가하는 평가자다. 아래의 activity.valueQuestion, 생각친구의 question, 학생의 answer를 한 쌍으로 읽고 JSON으로만 판정하라. level 기준: 0 내용 없음(모르겠어요, 그냥요, 활동과 무관), 1 대상이나 사실만 말하거나 막연한 좋다/싫다, 2 이유·구체적 느낌·비교·자기 선택·생활 적용 중 하나가 있음, 3 자기 경험이나 자기 기준을 근거로 이유와 함께 말함. 맞춤법이 틀려도 뜻을 기준으로 판정한다. 질문 속에만 있는 내용을 학생의 생각으로 보지 않는다. covers_value_question은 학생의 지금까지 답이 valueQuestion이 요구하는 요소를 채우는지 여부다. evidence에는 판정 근거가 되는 학생 말의 일부를 넣는다.",
    "turn_judge_output_schema": {
      "type": "OBJECT",
      "properties": {
        "level": {
          "type": "INTEGER"
        },
        "covers_value_question": {
          "type": "BOOLEAN"
        },
        "on_topic": {
          "type": "BOOLEAN"
        },
        "evidence": {
          "type": "STRING"
        }
      },
      "required": [
        "level",
        "covers_value_question",
        "on_topic",
        "evidence"
      ],
      "propertyOrdering": [
        "level",
        "covers_value_question",
        "on_topic",
        "evidence"
      ]
    },
    "summary_judge_prompt": "너는 초등학생의 최종 답변을 평가하는 평가자다. valueQuestion, 번호가 붙은 turns(질문+답), 학생이 확인한 의미, finalSummary를 보고 JSON으로만 판정하라. covers_all_usable_units는 학생이 말하거나 선택하거나 확인한 의미가 빠지지 않았는지, added_unsupported_content는 학생이 말하거나 확인하지 않은 새 생각·교과 지식·과장이 들어갔는지, used_rejected_meaning은 학생이 '아니요'라고 한 의미를 사용했는지, spelling_ok는 맞춤법과 띄어쓰기가 올바른지, tone_ok는 초등학생다운 해요체인지를 뜻한다.",
    "summary_judge_output_schema": {
      "type": "OBJECT",
      "properties": {
        "covers_all_usable_units": {
          "type": "BOOLEAN"
        },
        "added_unsupported_content": {
          "type": "BOOLEAN"
        },
        "used_rejected_meaning": {
          "type": "BOOLEAN"
